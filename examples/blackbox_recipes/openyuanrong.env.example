# Copy this file to openyuanrong.env and fill in the real values.
# Do not commit openyuanrong.env.

# Either AKERNEL_* or OPENYUANRONG_* works. The recipe maps OPENYUANRONG_*
# to AKERNEL_* before calling akernel_sdk.
OPENYUANRONG_SERVER_ADDRESS=
OPENYUANRONG_TOKEN=

# Usually keep this disabled for the current YR tunnel setup.
AKERNEL_TUNNEL_SSL_VERIFY=0

